import type { SourceStatus } from '../types';

interface SourceStatusListProps {
  sources: SourceStatus[];
}

export function SourceStatusList({ sources }: SourceStatusListProps) {
  if (!sources.length) {
    return <div className="empty-state">Source status is unavailable.</div>;
  }

  return (
    <div className="source-list">
      {sources.map((source) => (
        <div className="source-row" key={source.name}>
          <span className={`source-status tone-${source.status}`} />
          <div>
            <strong>{source.name}</strong>
            <small>{source.detail}</small>
          </div>
        </div>
      ))}
    </div>
  );
}
